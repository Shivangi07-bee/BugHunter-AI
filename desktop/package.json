{
  "name": "bughunter-ai-desktop",
  "version": "1.0.0",
  "description": "BugHunter AI - AI Security Reasoning Platform",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
 "build": {
  "appId": "ai.bughunter.desktop",
  "productName": "BugHunter AI",
  "icon": "build/bughunter-logo.png",
  "directories": {
    "output": "dist"
  },
  "files": [
    "main.js",
    "preload.js",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "../frontend/dist",
      "to": "frontend-dist"
    }
  ],
  "win": {
    "target": "nsis"
  }
}
  }
